{
  "workingDir": ".",
  "projectId": "my-project",
  "serverURL": "https://dx.fimidara.com/api",
  "metadata": {
    "environment": "production",
    "service": "log-consumer"
  },
  "batchSize": 100,
  "maxRecordBytes": 1048576,
  "flushIncompleteAfterMs": 5000,
  "logFiles": [
    {
      "path": "/var/log/application.log",
      "metadata": {
        "logType": "application"
      }
    },
    {
      "path": "/var/log/error.log",
      "metadata": {
        "logType": "error"
      }
    }
  ]
}
