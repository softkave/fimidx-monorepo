{
  "name": "ixtb-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:test": "env-cmd -f \".env.test\" next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start -p $PORT",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "email:build": "email build",
    "email:dev": "email dev",
    "email:export": "email export",
    "test": "env-cmd -f \".env.test\" vitest run --config ./vitest.config.ts",
    "test:e2e": "env-cmd -f \".env.test\" vitest run --config ./vitest.e2e.config.ts",
    "seed:fimidx-js-env:test": "env-cmd -f \".env.test\" tsx ./scripts/seedEnvTest.ts fimidx-js",
    "seed:symbolication-sample-app-env:test": "env-cmd -f \".env.test\" tsx ./scripts/seedEnvTest.ts symbolication-sample-app",
    "seed:fimidx-symbolication-e2e-env:test": "env-cmd -f \".env.test\" tsx ./scripts/seedEnvTest.ts fimidx-symbolication-e2e",
    "upload-source-maps": "npx --yes -- fimidx@latest source-maps upload --client-token \"$FIMIDX_SYMBOLICATION_AUTH_TOKEN\" --project-id \"$NEXT_PUBLIC_FIMIDX_LOGGER_PROJECT_ID\" --repo \"$NEXT_PUBLIC_FIMIDX_SYMBOLICATION_REPO\" --version \"$NEXT_PUBLIC_FIMIDX_SYMBOLICATION_VERSION\" --path .next",
    "delete-source-maps": "find .next -name '*.map' -type f -delete"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.1",
    "@better-auth/mongo-adapter": "^1.4.0",
    "@radix-ui/react-accordion": "^1.2.8",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.8",
    "@radix-ui/react-toggle-group": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@radix-ui/react-visually-hidden": "^1.1.2",
    "@react-email/components": "0.0.34",
    "@react-email/render": "1.0.5",
    "@uiw/react-json-view": "2.0.0-alpha.39",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "0.45.2",
    "fimidx-core": "workspace:*",
    "jsonwebtoken": "^9.0.2",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.509.0",
    "better-auth": "^1.4.0",
    "next": "15.4.10",
    "next-themes": "^0.4.4",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "resend": "^4.1.2",
    "softkave-js-utils": "0.17.0",
    "sonner": "^2.0.1",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "type-fest": "^4.37.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commander": "^12.1.0",
    "drizzle-kit": "0.31.10",
    "env-cmd": "^10.1.0",
    "eslint": "9.27.0",
    "eslint-config-next": "15.4.0-canary.51",
    "proper-lockfile": "^4.1.2",
    "react-email": "4.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.1.3"
  }
}
